# ---- کتاب‌خانه — production environment ----
# این فایل را به .env کپی و مقادیر واقعی را وارد کنید. هرگز .env را در گیت نگذارید.

APP_ENV=production
APP_NAME="کتاب‌خانه"
# نشانی کامل سایت (بدون اسلش انتهایی), برای بازگشت از درگاه پرداخت
APP_URL=https://example.com
APP_HTTPS=1
# مبدأ مجاز درخواست‌های API (همان دامنه سایت)
ALLOWED_ORIGIN=https://example.com

# ---- MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ketabkhaneh
DB_USER=ketabkhaneh
DB_PASS=

# ---- Session ----
SESSION_NAME=kk_session
SESSION_LIFETIME=0

# ---- فروشگاه ----
FREE_SHIPPING_FROM=500000
SHIPPING_POST=45000
SHIPPING_TIPAX=75000
LOW_STOCK_ALERT=5

# ---- درگاه پرداخت ایرانی (زرین‌پال) ----
# کلید مرچنت را از پنل زرین‌پال دریافت کنید
PAYMENT_GATEWAY=zarinpal
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=0

# ---- پیامک (کاوه‌نگار) ----
SMS_PROVIDER=log
SMS_API_KEY=
SMS_SENDER=

# ---- پشتیبان‌گیری ----
BACKUP_DIR=storage/backups
